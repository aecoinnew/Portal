{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../dist-server",
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["../server/**/*.ts", "../lib/types/**/*.ts", "../lib/calculations/**/*.ts"],
  "exclude": ["../node_modules"]
}
