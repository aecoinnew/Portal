# ============================================================
# EisaX Wealth Portal - Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ===== API server =====
API_HOST=0.0.0.0
API_PORT=4000

# ===== JWT authentication =====
# REQUIRED in production. Must be a strong random string (>=32 chars; 96+ recommended).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# WARNING: Rotating JWT_SECRET invalidates active sessions/tokens. If MFA secrets are
# encrypted using an application secret, follow the documented key-rotation procedure.
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=8h

# ===== Database =====
# SQLite file path. Use an absolute path on production hosts.
DATABASE_PATH=/data/emcoin.sqlite

# ===== File storage =====
# Where statement PDFs are stored (server-side).
STATEMENTS_DIR=/data/uploads/statements

# ===== CORS / public URL =====
# Origin the API allows CORS requests from. Must match the public URL of the frontend.
API_ORIGIN=http://localhost:3000

# Public URL the browser uses to call the API. Baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ===== Reverse proxy =====
# loopback (default, recommended): trust 127.0.0.1 only
# 1: trust a single external load balancer (use only if behind ALB/Cloudflare/etc.)
TRUST_PROXY=loopback

# ===== Deployment marker =====
# Values: staging | production
# Non-production values render an amber banner across the UI.
DEPLOYMENT_ENV=staging
NEXT_PUBLIC_DEPLOYMENT_ENV=staging

# ===== White-label branding =====
# All NEXT_PUBLIC_* variables are baked into the frontend at build time.
# Change them and rebuild to apply.
NEXT_PUBLIC_BRAND_NAME=EisaX Wealth
NEXT_PUBLIC_BRAND_SHORT_NAME=EisaX
NEXT_PUBLIC_BRAND_TAGLINE=Your investment portal.
NEXT_PUBLIC_BRAND_LOGO_URL=https://res.cloudinary.com/dfh3erwx1/image/upload/v1779708217/ChatGPT_Image_May_25_2026_03_20_26_PM_cvmazb.png
NEXT_PUBLIC_BRAND_LOGO_DARK_URL=https://res.cloudinary.com/dfh3erwx1/image/upload/v1779708217/ChatGPT_Image_May_25_2026_03_22_42_PM_qnzrsf.png
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#0B3D91
NEXT_PUBLIC_BRAND_ACCENT_COLOR=#B0944D
NEXT_PUBLIC_BRAND_LEGAL_FOOTER=EisaX Wealth is a licensed investment company. Past performance is not indicative of future results.

# ===== Default base currency =====
DEFAULT_BASE_CURRENCY=AED

# ===== Optional: market data feed =====
# When set to "yfinance", the cron at /opt/emcoin/scripts/update-market-prices.py
# fetches live prices for products with pricing_mode=api. Leave empty to disable.
MARKET_DATA_PROVIDER=yfinance
