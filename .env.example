# ============================================================
# Emcoin Investment Portal - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=4000

# --- Frontend ---
# The origin the API should allow CORS requests from.
# Must match the public URL of the Next.js frontend.
API_ORIGIN=http://localhost:3000

# --- JWT Authentication ---
# REQUIRED in production. Must be a long random string (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=8h

# --- Database ---
# Use absolute paths or paths outside the repo for production.
DATABASE_PATH=server/data/emcoin.sqlite
STATEMENTS_DIR=server/uploads/statements

# --- Frontend API URL ---
# The public URL the browser uses to reach the API.
# Must be accessible from the client's browser.
NEXT_PUBLIC_API_URL=http://localhost:4000/api


# --- Reverse Proxy Trust ---
# Set to 'loopback' when Nginx is on the same host (default, recommended).
# Set to '1' if behind a single external load balancer/CDN.
# Do NOT set to 'true' (trusts all proxies - unsafe).
TRUST_PROXY=loopback

# ============================================================
# PRODUCTION EXAMPLE (uncomment and adjust):
# ============================================================
# API_HOST=0.0.0.0
# API_PORT=4000
# API_ORIGIN=https://portal.example.com
# JWT_SECRET=<output of crypto.randomBytes(48).toString('hex')>
# JWT_EXPIRES_IN=8h
# DATABASE_PATH=/opt/emcoin/data/emcoin.sqlite
# STATEMENTS_DIR=/opt/emcoin/uploads/statements
# NEXT_PUBLIC_API_URL=https://portal.example.com/api
